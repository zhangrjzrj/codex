+++ b/Engine/Sources/Runtime/Plugins/Asyncore/Sources/asiocore/asyncore.cpp
@@ -113,8 +113,36 @@ namespace logic
 
 using namespace common;
 
+static net::telnet_server_ptr GTelnetServer;
+static bool GAsyncRuntimeStarted = false;
+
+bool async_start_telnet_server(const char* ip, unsigned short port)
+{
+	if (GTelnetServer)
+		return true;
+	GTelnetServer = boost::make_shared<net::telnet_server>();
+	if (!GTelnetServer->bind(ip, port))
+	{
+		GTelnetServer.reset();
+		return false;
+	}
+	GTelnetServer->listen_immediate(8);
+	return true;
+}
+
+void async_stop_telnet_server()
+{
+	if (!GTelnetServer)
+		return;
+	GTelnetServer->stop();
+	GTelnetServer.reset();
+}
+
 void async_start()
 {
+	if (GAsyncRuntimeStarted)
+		return;
+	GAsyncRuntimeStarted = true;
 	DLOG(INFO) << __FUNCTION__  << " start async... ";
 
 	std::string mname = IO_MANAGER.thread_name("main");
@@ -148,6 +176,8 @@ bool async_poll()
 void async_stop()
 {
 	DLOG(INFO) << __FUNCTION__  << " stop async... ";
+	GAsyncRuntimeStarted = false;
+	async_stop_telnet_server();
 	CONNECTION_MANAGER.stop();
 	TIMER_MANAGER.stop();
 	AREA_MANAGER.stop();
