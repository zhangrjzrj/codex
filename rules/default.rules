prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$path='D:\\hanhan\\股权合同_V2.5_修改\\超维算力股权协议-修改-V2 - 副本.docx'; $backup='D:\\hanhan\\股权合同_V2.5_修改\\超维算力股权协议-修改-V2 - 副本.修改前备份.docx'; if (-not (Test-Path -LiteralPath $backup)) { Copy-Item -LiteralPath $path -Destination $backup }; Add-Type -AssemblyName System.IO.Compression.FileSystem; $old1='未经乙方事先书面同意，甲方不得直接或间接转让、赠与、质押或以其他方式处分其持有的目标公司股权，亦不得通过变更实际控制人等方式规避本条约定。甲方拟转让股权的，应提前三十日书面通知乙方，载明拟转让的股权数量、价格、支付方式及受让方信息，乙方有权在收到完整通知后三十日内书面回复是否同意；逾期未书面回复的，视为乙方不同意。若甲方未能获得乙方同意而仍擅自转让，或乙方明确不同意后甲方仍实施转让的，乙方有权要求甲方按上一年度经审计的每股净资产价格受让乙方股权并向乙方支付【  】元的违约金。'; $new1='甲方拟直接或间接转让其持有的目标公司股权时，应至少提前三十日书面通知乙方，完整披露拟转让股权的数量、价格、支付方式、付款期限及受让方信息。乙方在同等条件下享有优先购买权；乙方自收到完整通知之日起三十日内未书面表示购买的，视为放弃本次优先购买权，甲方可以按照不优于通知所载的条件向第三方转让。转让条件发生实质变化的，甲方应重新通知乙方。'; $old2='甲方转让股权的，应保证其受让方以书面形式无条件接受并承继本协议项下甲方的全部义务、承诺及责任（包括但不限于股权处分限制义务），并与甲方就该等义务的履行向乙方承担连带保证责任。受让方未能签署书面承继文件的，甲方不得进行转让，否则乙方有权要求甲方按上一年度经审计的每股净资产价格受让乙方股权并向乙方支付【  】元的违约金。'; $new2='甲方应确保受让方在股权交割前签署书面承接文件，承接本协议中与受让股权相关的公司治理、表决权安排、信息披露、保密义务及乙方权益保护条款。受让方未签署承接文件而甲方仍完成转让的，构成甲方违约；未经乙方书面免除，甲方不因股权转让而免除转让前已经产生的义务、持续性义务及违约责任，并应向乙方支付人民币【  】元违约金。违约金不足以弥补乙方损失的，甲方还应赔偿不足部分。'; $zip=[IO.Compression.ZipFile]::Open($path,[IO.Compression.ZipArchiveMode]::Update); $entry=$zip.GetEntry('word/document.xml'); $reader=[IO.StreamReader]::new($entry.Open()); $xmlText=$reader.ReadToEnd(); $reader.Dispose(); [xml]$doc=$xmlText; $ns=[Xml.XmlNamespaceManager]::new($doc.NameTable); $ns.AddNamespace('w','http://schemas.openxmlformats.org/wordprocessingml/2006/main'); $replacements=@{$old1=$new1;$old2=$new2}; $count=0; foreach($paragraph in $doc.SelectNodes('//w:p',$ns)){ $texts=$paragraph.SelectNodes('.//w:t',$ns); $current=($texts | ForEach-Object {$_.InnerText}) -join ''; if($replacements.ContainsKey($current)){ $pPr=$paragraph.SelectSingleNode('./w:pPr',$ns); $children=@($paragraph.ChildNodes); foreach($child in $children){ if($child -ne $pPr){[void]$paragraph.RemoveChild($child)} }; $run=$doc.CreateElement('w','r','http://schemas.openxmlformats.org/wordprocessingml/2006/main'); $textNode=$doc.CreateElement('w','t','http://schemas.openxmlformats.org/wordprocessingml/2006/main'); $textNode.SetAttribute('space','http://www.w3.org/XML/1998/namespace','preserve'); $textNode.InnerText=$replacements[$current]; [void]$run.AppendChild($textNode); [void]$paragraph.AppendChild($run); $count++ } }; if($count -ne 2){ $zip.Dispose(); throw \"Expected 2 paragraph replacements, got $count\" }; $settings=[Xml.XmlWriterSettings]::new(); $settings.Encoding=[Text.UTF8Encoding]::new($false); $settings.Indent=$false; $memory=[IO.MemoryStream]::new(); $writer=[Xml.XmlWriter]::Create($memory,$settings); $doc.Save($writer); $writer.Dispose(); $bytes=$memory.ToArray(); $memory.Dispose(); $entry.Delete(); $newEntry=$zip.CreateEntry('word/document.xml',[IO.Compression.CompressionLevel]::Optimal); $stream=$newEntry.Open(); $stream.Write($bytes,0,$bytes.Length); $stream.Dispose(); $zip.Dispose(); Write-Output \"Replaced paragraphs: $count\"; Get-Item -LiteralPath $path,$backup | Select-Object FullName,Length,LastWriteTime"], decision="allow")
